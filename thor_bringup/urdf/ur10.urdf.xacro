<?xml version="1.0"?>
<!-- UR10 on a pedestal, with ros2_control mock hardware. Kinematics and
     limits from thor_math/test/data/ur10; the collision meshes are used
     for the visuals too. -->
<robot name="ur10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pedestal_height" value="0.75"/>
  <xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="command_interface" default="position"/>

  <material name="ur_grey"><color rgba="0.75 0.77 0.80 1.0"/></material>
  <material name="pedestal"><color rgba="0.25 0.25 0.28 1.0"/></material>

<link name="world" />
  
  
  <link name="base_link" />
  <link name="base_link_inertia">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/base.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/base.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0" />
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertia ixx="0.0061063308908" ixy="0.0" ixz="0.0" iyy="0.0061063308908" iyz="0.0" izz="0.01125" />
    </inertial>
  </link>
  <link name="shoulder_link">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/shoulder.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/shoulder.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="7.1" />
      <origin rpy="1.570796326794897 0 0" xyz="0.021 -0.027 0.0" />
      <inertia ixx="0.03408" ixy="2e-05" ixz="-0.00425" iyy="0.03529" iyz="8e-05" izz="0.02156" />
    </inertial>
  </link>
  <link name="upper_arm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.220941" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/upperarm.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.220941" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/upperarm.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="12.7" />
      <origin rpy="0 0 0" xyz="-0.232 0.0 0.158" />
      <inertia ixx="0.02814" ixy="5e-05" ixz="-0.01561" iyy="0.77068" iyz="2e-05" izz="0.76943" />
    </inertial>
  </link>
  <link name="forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.049042" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/forearm.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0.049042" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/forearm.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="4.27" />
      <origin rpy="0 0 0" xyz="-0.3323 0.0 0.068" />
      <inertia ixx="0.01014" ixy="8e-05" ixz="0.00916" iyy="0.30928" iyz="0.0" izz="0.30646" />
    </inertial>
  </link>
  <link name="wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.1149" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist1.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.1149" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist1.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0" />
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.018 0.007" />
      <inertia ixx="0.00296" ixy="-1e-05" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258" />
    </inertial>
  </link>
  <link name="wrist_2_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.1158" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist2.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.1158" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist2.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0" />
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.018 -0.007" />
      <inertia ixx="0.00296" ixy="-1e-05" ixz="0.0" iyy="0.00222" iyz="-0.00024" izz="0.00258" />
    </inertial>
  </link>
  <link name="wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.0922" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist3.stl" />
      </geometry>
      <material name="ur_grey" />
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 -0.0922" />
      <geometry>
        <mesh filename="package://thor_bringup/meshes/ur10/wrist3.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.365" />
      <origin rpy="0 0 0" xyz="0.0 0 -0.026" />
      <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.00041" iyz="0.0" izz="0.00034" />
    </inertial>
  </link>
  
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 ${pedestal_height}" />
    <parent link="world" />
    <child link="base_link" />
  </joint>
  
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link" />
    <child link="base_link_inertia" />
    
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia" />
    <child link="shoulder_link" />
    <origin rpy="0 0 0" xyz="0 0 0.1273" />
    <axis xyz="0 0 1" />
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin rpy="1.570796327 0 0" xyz="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="330.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="2.0943951023931953" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin rpy="0 0 0" xyz="-0.612 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="150.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_1_link" />
    <origin rpy="0 0 0" xyz="-0.5723 0 0.163941" />
    <axis xyz="0 0 1" />
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link" />
    <child link="wrist_2_link" />
    <origin rpy="1.570796327 0 0" xyz="0 -0.1157 -2.373046667922381e-11" />
    <axis xyz="0 0 1" />
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link" />
    <child link="wrist_3_link" />
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0922 -1.891053610911353e-11" />
    <axis xyz="0 0 1" />
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="ft_frame" />
  <joint name="wrist_3_link-ft_frame" type="fixed">
    <parent link="wrist_3_link" />
    <child link="ft_frame" />
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0" />
  </joint>
  
  <link name="base" />
  <joint name="base_link-base_fixed_joint" type="fixed">
    
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="base" />
  </joint>
  
  <link name="flange" />
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link" />
    <child link="flange" />
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0" />
  </joint>
  
  <link name="tool0" />
  <joint name="flange-tool0" type="fixed">
    
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0" />
    <parent link="flange" />
    <child link="tool0" />
  </joint>

  <link name="pedestal">
    <visual>
      <origin xyz="0 0 ${pedestal_height / 2}"/>
      <geometry><cylinder radius="0.12" length="${pedestal_height}"/></geometry>
      <material name="pedestal"/>
    </visual>
  </link>
  <joint name="pedestal_joint" type="fixed">
    <parent link="world"/>
    <child link="pedestal"/>
  </joint>

  <xacro:property name="joints" value="${['shoulder_pan_joint', 'shoulder_lift_joint', 'elbow_joint', 'wrist_1_joint', 'wrist_2_joint', 'wrist_3_joint']}"/>
  <xacro:property name="home" value="${[0.0, -1.2, 1.6, -1.97, -1.57, 0.0]}"/>
  <xacro:macro name="joint_interfaces" params="names:=^ values:=^">
    <xacro:if value="${names}">
      <xacro:property name="name" value="${names.pop(0)}"/>
      <xacro:property name="value" value="${values.pop(0)}"/>
      <joint name="${name}">
        <command_interface name="$(arg command_interface)"/>
        <state_interface name="position"><param name="initial_value">${value}</param></state_interface>
        <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      </joint>
      <xacro:joint_interfaces names="${names}" values="${values}"/>
    </xacro:if>
  </xacro:macro>

  <ros2_control name="ur10" type="system">
    <hardware>
      <plugin>$(arg hardware_plugin)</plugin>
    </hardware>
    <xacro:joint_interfaces names="${list(joints)}" values="${list(home)}"/>
  </ros2_control>
</robot>
