<?xml version='1.0' encoding='UTF-8'?>
<!-- PlotJuggler layout of the THOR demo (ur10_thor.launch.py plot:=true),
     on /thor_controller/thor_state, after Fig. 5 of the CBF paper.
     The thresholds C and C + delta_H are the cbf.safety_margin and
     cbf.distance_error of config/ur10_controllers.yaml: keep them in sync. -->
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab containers="1" tab_name="THOR">
   <Container>
    <DockSplitter count="4" sizes="0.3;0.3;0.2;0.2" orientation="-">
     <DockArea name="Barrier h [m] and projected velocities [m/s]">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range left="0" right="10" top="0.6" bottom="-0.6"/>
       <limitY/>
       <curve color="#1f77b4" name="/thor_controller/thor_state/h_now"/>
       <curve color="#9467bd" name="/thor_controller/thor_state/h_min"/>
       <curve color="#2ca02c" name="/thor_controller/thor_state/v_robot"/>
       <curve color="#d62728" name="/thor_controller/thor_state/v_obstacle"/>
       <curve color="#7f7f7f" name="zero"/>
      </plot>
     </DockArea>
     <DockArea name="Separation distance [m]">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range left="0" right="10" top="0.8" bottom="0"/>
       <limitY min="0"/>
       <curve color="#8c1a6a" name="/thor_controller/thor_state/min_distance"/>
       <curve color="#e377c2" name="/thor_controller/thor_state/distance"/>
       <curve color="#17becf" name="C + delta_H"/>
       <curve color="#1a3d5c" name="C"/>
      </plot>
     </DockArea>
     <DockArea name="Scaling and status (1 = braking)">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range left="0" right="10" top="1.05" bottom="-0.05"/>
       <limitY/>
       <curve color="#1f77b4" name="/thor_controller/thor_state/scaling"/>
       <curve color="#ff7f0e" name="/thor_controller/thor_state/status"/>
      </plot>
     </DockArea>
     <DockArea name="Solve time [s]">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range left="0" right="10" top="0.004" bottom="0"/>
       <limitY min="0"/>
       <curve color="#bcbd22" name="/thor_controller/thor_state/solve_time"/>
       <curve color="#d62728" name="control period"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="ROS2 Topic Subscriber">
   <use_header_stamp value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <boolean_strings_to_number value="true"/>
   <remove_suffix_from_strings value="true"/>
   <selected_topics value="/thor_controller/thor_state"/>
  </plugin>
 </Plugins>
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
 <customMathEquations>
  <snippet name="zero">
   <global></global>
   <function>return 0</function>
   <linked_source>/thor_controller/thor_state/h_now</linked_source>
  </snippet>
  <snippet name="C">
   <global></global>
   <function>return 0.05</function>
   <linked_source>/thor_controller/thor_state/min_distance</linked_source>
  </snippet>
  <snippet name="C + delta_H">
   <global></global>
   <function>return 0.05 + 0.02</function>
   <linked_source>/thor_controller/thor_state/min_distance</linked_source>
  </snippet>
  <snippet name="control period">
   <global></global>
   <function>return 0.002</function>
   <linked_source>/thor_controller/thor_state/solve_time</linked_source>
  </snippet>
 </customMathEquations>
 <snippets/>
</root>
