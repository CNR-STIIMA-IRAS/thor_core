# Doxygen configuration of thor_math, filled in by CMake (BUILD_DOCS=ON).
PROJECT_NAME           = "thor_math"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "MPC with time scaling and control barrier function"
OUTPUT_DIRECTORY       = "@THOR_MATH_DOCS_OUTPUT_DIR@"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/include/thor_math"
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/api.md"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@/include"
STRIP_FROM_INC_PATH    = "@CMAKE_CURRENT_SOURCE_DIR@/include"
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = "@THOR_MATH_DOCS_OUTPUT_DIR@/warnings.log"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = NO
HAVE_DOT               = NO
